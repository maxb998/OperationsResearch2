    "version": "0.2.0",
    "configurations": [
        {
            "type":"cppdbg",
            "name": "Debug",
            "preLaunchTask": "Build Debug",
            "request": "launch",
            "program": "${workspaceFolder}/bin/debug/main",
            "args": [
                "--file", "data/3000-6000/rl5915.tsp",
                "--mode", "nn",
                "--tlim", "20",

                "--graspType", "almostbest",
                //"--graspChance", "0.05",
                //"--nnTryall",
                //"--emFarthest",

                //"--metaInit", "nn",
                //"--metaRestartThreshold", "1000",
                //"--tabuTenureSize", "50",
                //"--vnsKickSize", "5,30",
                //"--geneticParams", "20,10,100,100",
                //"--annealTemperature", "2",

                //"--cplexInit", "em",
                //"--cplexDisablePatching",
                //"--cplexEnableWarmStart",
                //"--cplexDisableSolPosting",
                //"--cplexDisableUsercuts",
                //"--hardfixSmallest",

                "--2opt",
                "--3opt",

                "--seed", "2023",
                "--threads", "16",
                "--roundcosts",
                //"--plot", 
                //"--save",
                "--loglvl", "info",
                "--computationtype", "avx"
            ],
            "cwd": "${workspaceFolder}"
       },
       {
            "type":"cppdbg",
            "name": "Release",
            "preLaunchTask": "Build Release",
            "request": "launch",
            "program": "${workspaceFolder}/bin/release/main",
            "args": [
                "--file", "data/3000-6000/rl5915.tsp",
                "--mode", "nn",
                "--tlim", "20",

                "--graspType", "almostbest",
                //"--graspChance", "0.05",
                //"--nnTryall",
                //"--emFarthest",

                //"--metaInit", "nn",
                //"--metaRestartThreshold", "1000",
                //"--tabuTenureSize", "50",
                //"--vnsKickSize", "5,30",
                //"--geneticParams", "20,10,100,100",
                //"--annealTemperature", "2",

                //"--cplexInit", "em",
                //"--cplexDisablePatching",
                //"--cplexEnableWarmStart",
                //"--cplexDisableSolPosting",
                //"--cplexDisableUsercuts",
                //"--hardfixSmallest",

                "--2opt",
                "--3opt",

                "--seed", "2023",
                "--threads", "16",
                "--roundcosts",
                //"--plot", 
                //"--save",
                "--loglvl", "info",
                "--computationtype", "base"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
